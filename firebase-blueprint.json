{
  "entities": {
    "User": {
      "title": "User",
      "description": "校園使用者基本帳號資料，支援學生、教師、管理員三種角色",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "使用者唯一 ID (Firebase Auth UID)",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "電子信箱",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "姓名或暱稱",
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "description": "使用者角色權限",
          "enum": ["student", "teacher", "admin"]
        },
        "grade": {
          "type": "string",
          "description": "所屬年級 (例如: 三年級)",
          "maxLength": 20
        },
        "classId": {
          "type": "string",
          "description": "所屬班級代碼",
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "description": "所屬班級名稱",
          "maxLength": 50
        },
        "studentNumber": {
          "type": "string",
          "description": "學生座號或學號",
          "maxLength": 20
        },
        "avatar": {
          "type": "string",
          "description": "代表頭像識別碼",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "description": "帳號啟用狀態 (active 正常啟用 / disabled 停用)",
          "enum": ["active", "disabled"]
        },
        "passwordSet": {
          "type": "boolean",
          "description": "密碼是否已完成設定"
        },
        "needsActivation": {
          "type": "boolean",
          "description": "若教師尚未設定密碼，需完成安全啟用流程方可登入"
        },
        "authLinked": {
          "type": "boolean",
          "description": "是否已完成 Firebase Authentication 真實 UID 綁定"
        },
        "createdAt": {
          "type": "string",
          "description": "建立時間戳記"
        },
        "updatedAt": {
          "type": "string",
          "description": "更新時間戳記"
        }
      },
      "required": ["id", "name", "role"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "班級資料定義",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "班級唯一識別碼",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "班級名稱 (例如: 三年二班)",
          "maxLength": 50
        },
        "grade": {
          "type": "string",
          "description": "年級",
          "maxLength": 20
        },
        "teacherId": {
          "type": "string",
          "description": "班級導師 UID",
          "maxLength": 128
        },
        "teacherName": {
          "type": "string",
          "description": "班級導師姓名",
          "maxLength": 64
        },
        "studentCount": {
          "type": "number",
          "description": "班級學生人數"
        },
        "createdAt": {
          "type": "string",
          "description": "建立時間"
        }
      },
      "required": ["id", "name", "grade", "teacherId"]
    },
    "MoodLog": {
      "title": "MoodLog",
      "description": "學生每日心情簽到與情緒溫度計紀錄",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "心情紀錄代碼 ({studentId}_{YYYY-MM-DD})",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "description": "學生 UID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "學生姓名",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "description": "所屬班級代碼",
          "maxLength": 64
        },
        "mood": {
          "type": "string",
          "description": "心情類型",
          "enum": ["happy", "calm", "anxious", "sad", "angry", "tired"]
        },
        "score": {
          "type": "number",
          "description": "心情溫度分數 1-5 分"
        },
        "tags": {
          "type": "array",
          "description": "情境標籤列表"
        },
        "note": {
          "type": "string",
          "description": "心情小日記內容",
          "maxLength": 500
        },
        "date": {
          "type": "string",
          "description": "台灣日期 YYYY-MM-DD",
          "maxLength": 10
        },
        "createdAt": {
          "type": "string",
          "description": "紀錄建立時間"
        },
        "updatedAt": {
          "type": "string",
          "description": "紀錄更新時間"
        },
        "createdAtMs": {
          "type": "number",
          "description": "排序用毫秒時間戳"
        }
      },
      "required": ["id", "studentId", "classId", "mood", "score", "date"]
    },
    "CareNote": {
      "title": "CareNote",
      "description": "教師或輔導老師填寫的學生關懷追蹤紀錄",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "關懷筆記識別碼",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "description": "學生 UID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "學生姓名",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "description": "班級代碼",
          "maxLength": 64
        },
        "teacherId": {
          "type": "string",
          "description": "紀錄教師 UID",
          "maxLength": 128
        },
        "teacherName": {
          "type": "string",
          "description": "紀錄教師姓名",
          "maxLength": 64
        },
        "alertLevel": {
          "type": "string",
          "description": "關注等級",
          "enum": ["normal", "attention", "urgent"]
        },
        "content": {
          "type": "string",
          "description": "關懷內容與觀察細節",
          "maxLength": 1000
        },
        "actionTaken": {
          "type": "string",
          "description": "已採取的關懷措施",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "description": "建立時間"
        },
        "createdAtMs": {
          "type": "number",
          "description": "排序用毫秒時間戳"
        }
      },
      "required": ["id", "studentId", "classId", "teacherId", "alertLevel", "content"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "學生與 AI 心靈小夥伴的聊天紀錄",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "訊息識別碼",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "description": "學生 UID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "學生姓名",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "description": "學生所屬班級代碼",
          "maxLength": 64
        },
        "sender": {
          "type": "string",
          "description": "發言者身分 (student 或 ai)",
          "enum": ["student", "ai"]
        },
        "text": {
          "type": "string",
          "description": "對話內容",
          "maxLength": 4000
        },
        "selfReportedMood": {
          "type": "string",
          "description": "學生今日自評簽到心情",
          "enum": ["happy", "calm", "anxious", "sad", "angry", "tired"]
        },
        "modelDetectedEmotion": {
          "type": "string",
          "description": "AI 依對話脈絡判斷之情緒",
          "enum": ["happy", "calm", "anxious", "sad", "angry", "tired"]
        },
        "emotionTag": {
          "type": "string",
          "description": "顯示用情緒標籤",
          "maxLength": 30
        },
        "situationCategory": {
          "type": "string",
          "description": "對話情境分類",
          "maxLength": 50
        },
        "riskLevel": {
          "type": "string",
          "description": "安全風險等級",
          "enum": ["none", "low", "elevated", "critical"]
        },
        "aiStatus": {
          "type": "string",
          "description": "回覆來源狀態",
          "enum": ["gemini", "error_notice", "safety_fallback"]
        },
        "teacherNotified": {
          "type": "boolean",
          "description": "危機通報是否已成功寫入通知紀錄"
        },
        "timestamp": {
          "type": "string",
          "description": "時間 HH:mm"
        },
        "createdAt": {
          "type": "string",
          "description": "訊息時間"
        },
        "createdAtMs": {
          "type": "number",
          "description": "排序用毫秒時間戳"
        }
      },
      "required": ["id", "studentId", "classId", "sender", "text"]
    },
    "CrisisAlert": {
      "title": "CrisisAlert",
      "description": "校園安全危機通報與導師即時預警通知",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "通報紀錄代碼",
          "maxLength": 128
        },
        "studentId": {
          "type": "string",
          "description": "學生 UID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "學生姓名",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "description": "所屬班級代碼",
          "maxLength": 64
        },
        "className": {
          "type": "string",
          "description": "班級名稱",
          "maxLength": 50
        },
        "situationCategory": {
          "type": "string",
          "description": "危機事件分類",
          "maxLength": 50
        },
        "severity": {
          "type": "string",
          "description": "緊急程度",
          "enum": ["elevated", "critical"]
        },
        "triggerExcerpt": {
          "type": "string",
          "description": "觸發通報之訊息摘要",
          "maxLength": 600
        },
        "aiSummary": {
          "type": "string",
          "description": "系統安全摘要供導師參考",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "通報處理狀態",
          "enum": ["open", "acknowledged", "resolved"]
        },
        "acknowledgedBy": {
          "type": "string",
          "description": "接手處理教師 UID",
          "maxLength": 128
        },
        "acknowledgedByName": {
          "type": "string",
          "description": "接手處理教師姓名",
          "maxLength": 64
        },
        "acknowledgedAt": {
          "type": "string",
          "description": "接手處理時間"
        },
        "resolutionNote": {
          "type": "string",
          "description": "處遇備註",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "建立時間"
        },
        "createdAtMs": {
          "type": "number",
          "description": "排序用毫秒時間戳"
        }
      },
      "required": ["id", "studentId", "classId", "situationCategory", "severity", "status", "createdAtMs"]
    },
    "ChatAccessLog": {
      "title": "ChatAccessLog",
      "description": "教師查閱學生 AI 對話紀錄之稽核日誌",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "稽核紀錄代碼",
          "maxLength": 128
        },
        "teacherId": {
          "type": "string",
          "description": "查閱教師 UID",
          "maxLength": 128
        },
        "teacherName": {
          "type": "string",
          "description": "查閱教師姓名",
          "maxLength": 64
        },
        "studentId": {
          "type": "string",
          "description": "被查閱學生 UID",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "description": "被查閱學生姓名",
          "maxLength": 64
        },
        "classId": {
          "type": "string",
          "description": "班級代碼",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "description": "查閱時間戳記"
        },
        "createdAtMs": {
          "type": "number",
          "description": "排序用毫秒時間戳"
        },
        "purpose": {
          "type": "string",
          "description": "查閱原因或輔導目的",
          "maxLength": 300
        }
      },
      "required": ["id", "teacherId", "studentId", "classId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "校園使用者個人檔案資料"
    },
    "/admins/{adminId}": {
      "schema": "User",
      "description": "受保護的系統管理員授權名冊"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "班級資料"
    },
    "/mood_logs/{logId}": {
      "schema": "MoodLog",
      "description": "每日心情簽到紀錄集合"
    },
    "/care_notes/{noteId}": {
      "schema": "CareNote",
      "description": "教師輔導關懷紀錄"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "AI 聊天室對話歷史"
    },
    "/crisis_alerts/{alertId}": {
      "schema": "CrisisAlert",
      "description": "校園安全危機通報紀錄"
    },
    "/chat_access_logs/{logId}": {
      "schema": "ChatAccessLog",
      "description": "教師查看 AI 對話之安全稽核紀錄"
    }
  }
}
